  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('service is UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Open payer account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Postman Payer\",\n  \"type\": \"CHEQUING\",\n  \"initialDeposit\": 1000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const account = pm.response.json();",
                  "pm.test('201 Created with Location header', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.have.header('Location', '/api/accounts/' + account.accountNumber);",
                  "});",
                  "pm.test('account number is 10 digits', () => pm.expect(account.accountNumber).to.match(/^\\d{10}$/));",
                  "pm.test('opening balance equals initial deposit', () => pm.expect(account.balance).to.eql(1000));",
                  "pm.test('new accounts are ACTIVE in CAD', () => {",
                  "    pm.expect(account.status).to.eql('ACTIVE');",
                  "    pm.expect(account.currency).to.eql('CAD');",
                  "});",
                  "pm.collectionVariables.set('payer', account.accountNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open payee account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Postman Payee\",\n  \"type\": \"SAVINGS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('balance defaults to zero', () => pm.expect(pm.response.json().balance).to.eql(0));",
                  "pm.collectionVariables.set('payee', pm.response.json().accountNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{payer}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{payer}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('response matches account schema', () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: 'object',",
                  "        required: ['accountNumber', 'ownerName', 'type', 'currency', 'balance', 'status', 'createdAt'],",
                  "        properties: {",
                  "            accountNumber: { type: 'string', pattern: '^[0-9]{10}$' },",
                  "            type: { enum: ['CHEQUING', 'SAVINGS'] },",
                  "            balance: { type: 'number', minimum: 0 },",
                  "            status: { enum: ['ACTIVE', 'FROZEN'] }",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{payee}}/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{payee}}",
                "deposits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25.25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('balance increased by deposit', () => pm.expect(pm.response.json().balance).to.eql(25.25));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown account returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/0000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "0000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 with ACCOUNT_NOT_FOUND', () => {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().code).to.eql('ACCOUNT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Open account with blank owner returns 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \" \",\n  \"type\": \"CHEQUING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with field error on ownerName', () => {",
                  "    pm.response.to.have.status(400);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('VALIDATION_FAILED');",
                  "    pm.expect(body.errors.map(e => e.field)).to.include('ownerName');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{payer}}\",\n  \"toAccount\": \"{{payee}}\",\n  \"amount\": 150.75,\n  \"description\": \"Rent share\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const transfer = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('transfer COMPLETED', () => pm.expect(transfer.status).to.eql('COMPLETED'));",
                  "pm.test('reference is a UUID', () => pm.expect(transfer.reference).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.test('response time under 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.collectionVariables.set('transferRef', transfer.reference);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay transfer with same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{payer}}\",\n  \"toAccount\": \"{{payee}}\",\n  \"amount\": 150.75,\n  \"description\": \"Rent share\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, not a second 201', () => pm.response.to.have.status(200));",
                  "pm.test('returns the original transfer', () => pm.expect(pm.response.json().reference).to.eql(pm.collectionVariables.get('transferRef')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payer balance debited exactly once",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{payer}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{payer}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('1000.00 - 150.75 = 849.25', () => pm.expect(pm.response.json().balance).to.eql(849.25));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payee balance credited exactly once",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{payee}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{payee}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('25.25 + 150.75 = 176.00', () => pm.expect(pm.response.json().balance).to.eql(176));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers/{{transferRef}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers",
                "{{transferRef}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('amount and parties match', () => {",
                  "    const t = pm.response.json();",
                  "    pm.expect(t.amount).to.eql(150.75);",
                  "    pm.expect(t.fromAccount).to.eql(pm.collectionVariables.get('payer'));",
                  "    pm.expect(t.toAccount).to.eql(pm.collectionVariables.get('payee'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transaction history shows the debit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{payer}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{payer}}",
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const entries = pm.response.json();",
                  "pm.test('newest entry is the transfer DEBIT', () => {",
                  "    pm.expect(entries[0].type).to.eql('DEBIT');",
                  "    pm.expect(entries[0].transferReference).to.eql(pm.collectionVariables.get('transferRef'));",
                  "    pm.expect(entries[0].balanceAfter).to.eql(849.25);",
                  "});"
                ]
              }
            }
          ]
        },
